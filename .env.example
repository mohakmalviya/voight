# HTTP is accepted ONLY on localhost for local development.
PUBLIC_ORIGIN=http://localhost:8787
UPSTREAM=http://127.0.0.1:8788
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data

# public: anyone can browse, budgets per network. private: invited passkey holders only.
MODE=public

# Set this when a reverse proxy, CDN or load balancer sits in front. Only these peers may set X-Forwarded-For.
# TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1

# Budgets. Omit to use the defaults for the chosen mode (see README).
# REQUESTS_PER_MINUTE=300
# EXTRACTION_WINDOW_SECONDS=600
# RESOURCES_PER_WINDOW=1000
# BYTES_PER_WINDOW=209715200
# MAX_CONCURRENT_REQUESTS=16
# CONNECTIONS_PER_MINUTE=600
# MAX_RESPONSE_BYTES=5242880

# Public mode escalation: strikes, timed blocks, proof-of-work checks.
# STRIKES_PER_WINDOW=30
# STRIKE_WINDOW_SECONDS=600
# BAN_SECONDS=300
# MAX_BAN_SECONDS=86400
# CHALLENGE_DIFFICULTY=16
# CLEARANCES_PER_WINDOW=5
# CLEARANCE_SECONDS=3600

# Private mode sessions.
# SESSION_SECONDS=300
# PAGES_PER_SESSION=60

# Observe records declared automation; enforce rejects it. Neither proves humanity.
AUTOMATION_POLICY=observe
